# =============================================================================
# food-order — 环境变量模板
# 复制为 .env 并填入真实值；.env 已 gitignore，绝不提交。
# =============================================================================

# ---------- 数据库 (MySQL 8) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=food_order
DB_PASSWORD=
DB_NAME=food_order

# ---------- JWT 鉴权 (HS256) ----------
# 生成方式：openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080          # 默认 7 天

# ---------- 后端服务 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 开发默认 http://localhost:5173；多源逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- 前端 (Vite) ----------
# Vite 仅注入 VITE_ 前缀变量到前端代码
VITE_API_BASE_URL=http://localhost:8000

# ---------- 第三方服务（按需启用） ----------
# 微信小程序 / 公众号 / 支付（如启用）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# 对象存储（菜品/店铺图片）
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 地图与定位（可选 — 配送范围、配送轨迹）
MAP_PROVIDER=amap
AMAP_API_KEY=

# 短信通知（验证码、订单状态）
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SIGN_NAME=