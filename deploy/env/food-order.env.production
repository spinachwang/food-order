# food-order · 生产环境变量模板
# 复制为 /opt/food-order/.env，填入真实值
# 必须 chmod 600 + chown food-order:food-order
#
# 与 .env.example 的差异：所有"开发默认"被改写为"生产安全值"

# =============================================================================
# 数据库 (MySQL 8 · 127.0.0.1:3306)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=food_order
DB_PASSWORD=__CHANGE_ME__
DB_NAME=food_order
DB_NAME_TEST=food_order_test

# =============================================================================
# JWT 鉴权 (HS256)
# =============================================================================
# 生成：openssl rand -hex 32
JWT_SECRET=__CHANGE_ME_WITH_openssl_rand_hex_32__
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# =============================================================================
# 后端服务
# =============================================================================
# 生产只监听 loopback；公网访问走 nginx 反代
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# CORS 必须改为生产前端域名（不是 localhost）
CORS_ALLOW_ORIGINS=https://app.example.com

# =============================================================================
# 第三方服务
# =============================================================================
# 高德 (F030 餐厅搜索 + F031 天气)
MAP_PROVIDER=amap
AMAP_API_KEY=__CHANGE_ME__
AMAP_DEFAULT_RADIUS_METERS=1500
AMAP_TIMEOUT_SECONDS=2.0

# LLM
MINIMAX_API_KEY=__CHANGE_ME__
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_SECONDS=30
MINIMAX_MAX_RETRIES=2
MINIMAX_THINKING=disabled

# =============================================================================
# 日志（observability 层 · 生产推荐）
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json                # 走日志聚合
LOG_PROMPT_DEBUG=false         # 生产不落盘 LLM prompt/response
LOG_FILE_PATH=/var/log/food-order/app.log
LOG_FILE_MAX_BYTES=10485760    # 10 MB
LOG_FILE_BACKUP_COUNT=5

# =============================================================================
# 前端构建时注入 (VITE_* 在 build 时冻结到 bundle)
# 改这个值后必须重新 `pnpm build` 并重新部署 frontend/dist
# =============================================================================
VITE_API_BASE_URL=https://api.example.com
